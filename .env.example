# Local database. The default is data/bakery_pos.sqlite3.
BAKERY_POS_DB_PATH=

# Keep 127.0.0.1 for this PC only. For trusted shop Wi-Fi, set 0.0.0.0
# and configure a strong access token first.
BAKERY_POS_HOST=127.0.0.1
BAKERY_POS_PORT=8000
BAKERY_POS_ACCESS_TOKEN=

# Optional one-way SQLite-to-Google-Sheets backup/sync.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=
